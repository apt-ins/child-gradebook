{
  "name": "child-gradebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "build:mobile": "VITE_LOCAL_APP=true vite build --outDir mobile/www",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "adm-zip": "^0.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fflate": "0.8.3",
    "helmet": "^8.1.0",
    "lucide-vue-next": "^0.468.0",
    "motion-v": "^2.8.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "sql.js": "^1.13.0",
    "vue": "^3.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vue-tsc": "^3.1.0"
  }
}
